{
    "name": "sudoku",
    "version": "1.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm build && wrangler dev",
        "dev:vite": "vite",
        "build": "tsc -b && vite build",
        "lint": "oxlint --type-aware --type-check --fix src",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "preview": "wrangler dev",
        "deploy": "pnpm build && wrangler deploy",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.105.0",
        "@tanstack/react-router": "^1.170.46",
        "cors": "^2.8.6",
        "drizzle-orm": "^0.45.4",
        "express": "^5.3.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "uuid": "^14.0.3",
        "workbox-window": "^7.4.1",
        "zod": "^4.6.7",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261030.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/router-plugin": "^1.168.48",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.5",
        "concurrently": "^10.0.6",
        "drizzle-kit": "^0.31.11",
        "jsdom": "^30.1.3",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "~7.0.2",
        "vite": "^8.3.5",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.0.5",
        "wrangler": "^4.156.0"
    }
}
